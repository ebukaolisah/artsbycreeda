# =========================================================
# Arts By Creeda environment variables
# Copy these into Vercel project Settings -> Environment Variables.
# Production + Preview + Development.
# =========================================================

# --- Public site URL used for canonical tags, sitemaps, callbacks, and links
NEXT_PUBLIC_BASE_URL=https://www.artsbycreeda.com

# --- Public contact / tracking placeholders
# Use a full wa.me URL, for example:
# NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/2340000000000?text=I%20want%20to%20order%20a%20portrait
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- Paystack (https://dashboard.paystack.com/#/settings/developers)
# Use sk_test_... and pk_test_... keys for staging, sk_live_... / pk_live_... for production.
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_SECRET_KEY_HERE
PAYSTACK_PUBLIC_KEY=YOUR_PAYSTACK_PUBLIC_KEY_HERE
# Webhook URL to register in Paystack dashboard:
#   https://www.artsbycreeda.com/api/paystack/webhook

# --- Telegram bot (talk to @BotFather, then /newbot)
# Format: <numeric_id>:<35-char-alphanumeric-secret> provided by BotFather.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# Run this once after creating the bot and sending it a /start message:
#   curl https://api.telegram.org/bot<your-token>/getUpdates
# Then copy chat.id here.
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# --- Admin dashboard
# Long random string for JWT signing. Generate one with:
#   openssl rand -base64 48
ADMIN_JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# The password you will use at /admin/login
ADMIN_PASSWORD=change-this-to-something-strong

# --- Auto-injected by Vercel (do NOT set manually):
# POSTGRES_URL, POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING,
# POSTGRES_USER, POSTGRES_HOST, POSTGRES_PASSWORD, POSTGRES_DATABASE
#
# Note: customer reference photos are sent directly to the studio Telegram chat.
# No third-party blob storage is used.
